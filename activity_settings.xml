<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações da Nexus"
            android:textColor="@color/nexus_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chave de API (Anthropic)"
            android:textColor="@color/nexus_dim"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/editApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/nexus_text"
            android:background="@drawable/bg_panel"
            android:padding="10dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crie a sua em console.anthropic.com — o uso é cobrado pela Anthropic, por token."
            android:textColor="@color/nexus_dim"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modelo"
            android:textColor="@color/nexus_dim"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/editModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text"
            android:background="@drawable/bg_panel"
            android:padding="10dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ex: claude-sonnet-5-5 (equilibrado) ou claude-opus-5-5 (mais forte, mais caro)"
            android:textColor="@color/nexus_dim"
            android:textSize="12sp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar"/>
    </LinearLayout>
</ScrollView>
