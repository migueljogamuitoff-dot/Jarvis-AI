<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Nexus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" android:label="Configurações" />
        <activity android:name=".DevicesActivity" android:exported="false" android:label="Dispositivos" />
        <activity android:name=".VisionActivity" android:exported="false" android:label="Nexus Visão" />
        <activity android:name=".ContentViewerActivity" android:exported="false" android:label="Conteúdo" />

        <service
            android:name=".NexusBubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
