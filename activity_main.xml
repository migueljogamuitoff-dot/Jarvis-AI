<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexus_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXUS"
            android:textColor="@color/nexus_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_dim"
            android:textSize="13sp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textColor="@color/nexus_cyan"
            android:textSize="18sp"
            android:padding="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_panel"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtStatBattery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/nexus_dim"
            android:textSize="11sp"
            android:text="BAT --"/>

        <TextView
            android:id="@+id/txtStatRam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/nexus_dim"
            android:textSize="11sp"
            android:text="RAM --"/>

        <TextView
            android:id="@+id/txtStatUptime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/nexus_dim"
            android:textSize="11sp"
            android:text="UP --"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="4dp">

        <com.seuprojeto.nexus.OrbView
            android:id="@+id/orbView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NEXUS CORE • ATIVO"
        android:textColor="@color/nexus_cyan"
        android:textSize="11sp"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_panel"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/logContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnInterrupt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTERROMPER"
            android:textSize="11sp"
            android:background="@drawable/bg_pill_outline"
            android:textColor="@color/nexus_pink"
            android:minHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtMicState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MICROFONE: OFF"
            android:textColor="@color/nexus_dim"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_panel"
        android:padding="6dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Fale com a Nexus..."
            android:textColorHint="@color/nexus_dim"
            android:textColor="@color/nexus_text"
            android:background="@android:color/transparent"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙"
            android:textSize="20sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➤"
            android:textColor="@color/nexus_cyan"
            android:textSize="20sp"
            android:padding="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnDevices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dispositivos"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnVision"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Visão"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCastTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📺 Transmitir p/ TV"
            android:textSize="10sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnBubble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bolinha"
            android:textSize="10sp"/>
    </LinearLayout>

</LinearLayout>
